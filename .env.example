# Supabase Configuration (from Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Frontend (Vite) — must be prefixed with VITE_
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Dashboard auth (code TOTP uniquement) — voir DASHBOARD_AUTH.md
# Les 2 sont OBLIGATOIRES, sinon le serveur refuse de démarrer.
DASHBOARD_TOTP_SECRET=base32_secret_genere_une_fois
DASHBOARD_SESSION_SECRET=hex_aleatoire_32_octets

# Database (if needed, otherwise Supabase URL is used)
DATABASE_URL=postgresql://...

# Pont CRM Canopy — token Bearer partagé avec l'app Canopy (= RELEAF_DEALS_API_KEY
# côté Canopy). À définir AUSSI sur Render (Production). Sans lui, /api/releaf-deals
# répond 503.
CANOPY_API_TOKEN=token_partage_avec_canopy
